# Local development only. Copy to .env (which is gitignored) to exercise the
# contact form on localhost.
#
# ORIGIN and ADDRESS_HEADER are NOT needed here: `vite dev` derives the origin
# from the request, and getClientAddress() already returns the real address
# when there is no proxy in front.

# --- captcha ---
# Run `npm run dev:captcha` in another terminal, then the form accepts any
# non-empty solution. Send the literal "FAIL" to exercise the rejection path.
FRIENDLYCAPTCHA_ENDPOINT=http://127.0.0.1:4499
FRIENDLYCAPTCHA_API_KEY=local-dev
# Leave blank to render the widget in an obviously-unconfigured state, or paste
# a real sitekey once localhost is an allowed hostname on your Friendly Captcha site.
PUBLIC_FRIENDLYCAPTCHA_SITEKEY=

# --- mail ---
# Real Resend key. Until antoinedespres.com is verified, send FROM
# onboarding@resend.dev, which needs no verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Resend's test inbox: always reports delivered, never actually emails anyone.
# Swap for your own address to receive the mail for real.
CONTACT_TO_EMAIL=delivered@resend.dev
