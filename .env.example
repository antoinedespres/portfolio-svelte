# --- adapter-node runtime ---
# Required. SvelteKit rejects form POSTs whose Origin does not match, so without
# this every contact-form submission fails with "Cross-site POST form
# submissions are forbidden".
ORIGIN=https://antoinedespres.com
# Required behind a reverse proxy. Without it getClientAddress() returns the
# proxy's socket address, so every visitor shares one rate-limit bucket and a
# single spammer locks out the whole site.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender. Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=contact@example.com
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=you@example.com
#
# Both are placeholders on purpose: the real addresses live only in the .env on
# the server. This repository is public, and publishing the address here would
# undo the point of replacing the site's mailto: links with a form.

# Friendly Captcha — https://friendlycaptcha.com
# The free plan covers non-commercial use: 1 domain, 1000 requests/month.
FRIENDLYCAPTCHA_API_KEY=
PUBLIC_FRIENDLYCAPTCHA_SITEKEY=
# Optional: override the siteverify endpoint. Defaults to the EU one.
# FRIENDLYCAPTCHA_ENDPOINT=https://global.frcapi.com/api/v2/captcha/siteverify
